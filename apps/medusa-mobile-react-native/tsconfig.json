{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@styles/*": ["./app/styles/*"],
      "@screens/*": ["./app/screens/*"],
      "@components/*": ["./app/components/*"],
      "@constants/*": ["./app/constants/*"],
      "@api/*": ["./app/api/*"],
      "@utils/*": ["./app/utils/*"],
      "@data/*": ["./app/data/*"],
      "@types/*": ["./app/types/*"]
    }
  }
}